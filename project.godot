; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (see README.md)

config_version=5

[application]

config/name="Pocket Boundary"
config/description="Pakistan-inspired arcade cricket: from the neighbourhood pitch to the floodlights."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.176, 0.141, 1)
boot_splash/show_image=false
run/low_processor_mode=false

[autoload]

Save="*res://scripts/services/save_service.gd"
Audio="*res://scripts/services/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
buffering/agile_event_flushing=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.176, 0.141, 1)
